# ============================================================
# Frontend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Adobe PDF Embed API Key (get from https://developer.adobe.com/console)
VITE_ADOBE_EMBED_KEY=

# Backend API base URL (default for local dev)
VITE_API_BASE=http://localhost:5001

# TTS config (passed to UI components)
VITE_TTS_PROVIDER=gcp
VITE_TTS_VOICES=en-US-Neural2-F,en-US-Neural2-D
