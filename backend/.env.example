# ============================================================
# Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Configuration ---
# For local dev, set ONE of these:
#   GEMINI_API_KEY=your_google_api_key    (or)
#   GOOGLE_API_KEY=your_google_api_key    (or)
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- TTS Configuration ---
# TTS_PROVIDER: gcp | azure | local
TTS_PROVIDER=gcp
GCP_TTS_VOICE=en-US-Neural2-F
GCP_TTS_LANGUAGE=en-US
GCP_TTS_RATE=1.08
GCP_TTS_PITCH=0.0
TTS_CLOUD_MAX_CHARS=3000
TTS_TARGET_WORDS=700

# For Azure TTS (if TTS_PROVIDER=azure):
# AZURE_TTS_KEY=
# AZURE_TTS_ENDPOINT=

# Default voices for 2-speaker podcast mode
DEFAULT_TTS_VOICES=en-US-Neural2-F,en-US-Neural2-D
TTS_WPM=165
