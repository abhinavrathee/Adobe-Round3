GEMINI_API_KEY=AIzaSyDb-FeUAeJH28hAVc2p5CiiuTf3CQL2ZUg
GEMINI_MODEL=gemini-2.5-flash

# TTS: use 'local' for dev (no cloud credentials needed)
# For evaluation, Adobe will pass TTS_PROVIDER=azure via Docker -e flag
TTS_PROVIDER=local

GCP_TTS_VOICE=en-US-Neural2-F
GCP_TTS_LANGUAGE=en-US
GCP_TTS_RATE=1.08
GCP_TTS_PITCH=0.0
TTS_CLOUD_MAX_CHARS=3000
TTS_TARGET_WORDS=700

# Default voices for 2-speaker podcast mode
DEFAULT_TTS_VOICES=en-US-Neural2-F,en-US-Neural2-D

# pace/timing knobs
TTS_WPM=165
