GEMINI_API_KEY=AIzaSyDQ7a-8vs2i7uzSsl72jCz30-u6ZtS_ABo
GEMINI_MODEL=gemini-2.5-flash

TTS_PROVIDER=gcp
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

GCP_TTS_VOICE=en-US-Neural2-F
GCP_TTS_LANGUAGE=en-US

# <= THIS MUST BE POSITIVE so we chunk long scripts:
TTS_CLOUD_MAX_CHARS=3000
TTS_TARGET_WORDS=700  

# Optional: default voices for 2-speaker mode
DEFAULT_TTS_VOICES=en-US-Neural2-F,en-US-Neural2-D

# pace/timing knobs
TTS_WPM=165         # expected speaking rate used for 2–5 min bounds
GCP_TTS_RATE=1.08   # 1.0 = default pace, >1.0 slightly faster
GCP_TTS_PITCH=0.0

